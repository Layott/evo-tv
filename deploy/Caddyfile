# EVO TV edge. Lives at /srv/evotv/Caddyfile on the droplet.
# Caddy handles Let's Encrypt issuance and renewal with no configuration.
#
# Hostnames come from /srv/evotv/.env so the staging-to-production flip is an
# env edit plus `docker compose up -d caddy`, not a file edit on the box:
#
#   staging (no DNS yet, sslip.io resolves any *.1-2-3-4.sslip.io to 1.2.3.4)
#     API_HOST=api.203-0-113-7.sslip.io
#     WEB_HOSTS=203-0-113-7.sslip.io
#     APP_HOST=app.203-0-113-7.sslip.io
#
#   production
#     API_HOST=api.evotv.co
#     WEB_HOSTS=evotv.co, www.evotv.co
#     APP_HOST=app.evotv.co
#     REDIRECT_HOSTS=evotv.africa, www.evotv.africa
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			# 0 = no write timeout. Required: /api/sse/* holds connections open
			# indefinitely and any finite value would cut them mid-stream.
			write 0
			idle 10m
		}
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Both api containers.
#
# Three mechanisms, and all three are needed. Measured with one container
# stopped: active checks alone let 8 of 20 requests through to the dead
# upstream as 502s, because at a 10s interval and 2 failures the removal
# window is up to 20 seconds and least_conn keeps dealing it traffic the
# whole time.
#
#   fail_duration    passive. One failed request takes the upstream out
#                    immediately, rather than waiting for the next poll.
#   lb_try_duration  retry. A request that hits a dying upstream is retried
#                    against the healthy one, so the client never sees the
#                    502 at all.
#   health_uri       active. Brings an upstream back automatically once it
#                    answers again, which passive checking alone cannot do.
#
# Deliberately NOT setting unhealthy_status: that would retry on any 5xx,
# including genuine application errors, and a retried POST can duplicate a
# side effect that already happened.
(api_upstreams) {
	lb_policy least_conn
	lb_try_duration 5s
	lb_try_interval 250ms
	fail_duration 30s
	max_fails 1
	health_uri /api/health
	health_interval 5s
	health_timeout 3s
	health_passes 1
	health_fails 2
}

# The Next app. It is not just an API: it serves 94 pages across (public),
# (auth), (authed) and (admin), with role gating in proxy.ts. Two hostnames
# reach the same containers for different audiences:
#
#   api.evotv.co   the native iOS/Android app, bearer tokens, grey-clouded
#                  on Cloudflare because proxied connections die at ~100s and
#                  that would kill every SSE stream
#   app.evotv.co   the web app in a browser
#
# Same-origin for the browser, which is why the web client needs no CORS
# preflight at all when served from the host it calls.
(evotv_next) {
	# flush_interval -1 disables response buffering. Without it Caddy holds the
	# event stream and live chat appears frozen to the client.
	#
	# Fanning SSE across two containers is only correct because lib/sse/bus.ts
	# publishes through Valkey. A client can subscribe on api-1 while the emit
	# happens on api-2. With REDIS_URL unset that message is silently lost, so
	# never scale this block without it.
	@sse path /api/sse/*
	handle @sse {
		reverse_proxy api-1:3060 api-2:3060 {
			import api_upstreams
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy api-1:3060 api-2:3060 {
			import api_upstreams
			header_up X-Real-IP {remote_host}
		}
	}

	# What a visitor sees while a deploy is in flight.
	#
	# deploy.sh restarts one container at a time and waits for health, so the
	# other one usually keeps serving. Usually is not always: a migration, a
	# slow build or a failed container leaves a window where nothing answers,
	# and the site's own buttons then fail with no explanation, which is what
	# the owner saw. This is that explanation, and it reloads itself.
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			root * /srv/maintenance
			rewrite * /maintenance.html
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}

	request_body {
		max_size 100MB
	}
}

# ---------------------------------------------------------------- backend API
{$API_HOST} {
	import common

	# Self-hosted live (Path A). Only reachable when the `rtmp` profile is up;
	# without it this block simply 502s and the Cloudflare path is unaffected.
	#
	# Two things matter here and both are easy to get wrong:
	#   - the playlist must never be cached, or viewers sit on a stale segment
	#     list and playback stalls a few seconds in;
	#   - segments are immutable, so they should be cached hard.
	handle /hls/* {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		}
		@playlist path *.m3u8
		header @playlist Cache-Control "no-cache, no-store, must-revalidate"
		@segment path *.ts
		header @segment Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy nginx-rtmp:8080
	}

	import evotv_next
}

# ------------------------------------------------------------- web app
#
# app. is a 301 to the apex. Both hostnames served the same application, which
# is duplicate content to a search engine and two places to check when
# something looks wrong. Nothing is lost: the native apps never talk to this
# hostname, they call {$API_HOST} directly.
#
# Safe because COOKIE_DOMAIN is `.evotv.co`, so the session cookie is valid on
# the apex too and a signed-in visitor stays signed in across the redirect. If
# COOKIE_DOMAIN is ever unset, revert this to `import evotv_next` first or
# everyone on app. lands signed out.
{$APP_HOST} {
	import common
	redir https://{$REDIRECT_TARGET:evotv.co}{uri} permanent
}

# ------------------------------------------------------------------ evotv.co
#
# The Next app, not the old static marketing site.
#
# This served /srv/web, a hand-built index.html from before the app had a
# landing page of its own. The app has one now: a server-rendered guest page
# with the real programme grid read from `epg_slots`, so it changes when the
# schedule does instead of being edited by hand and redeployed.
#
# `proxy.ts` keeps the two audiences apart on the same hostname. A guest gets
# the landing page at `/`; a signed-in visitor is redirected to `/home` before
# it renders, so the landing stays a pure guest surface.
#
# Rolling back is a two line edit and a `caddy reload`: the old site is still
# on disk at /srv/evotv/web, untouched.
#
#	root * /srv/web
#	try_files {path} /index.html
#	file_server
{$WEB_HOSTS} {
	import common
	import evotv_next
}

# The Expo web export used to be served from /srv/app as a static SPA. It is
# gone: the Next app covers the same screens with server rendering, so search
# engines see real HTML instead of an empty div, and there is one web front-end
# to keep in sync instead of two. /srv/app is now unused.
#
# {$APP_HOST} and {$WEB_HOSTS} now serve the same application. Making app.
# a 301 to the apex is the tidy end state and stops the two hostnames competing
# as duplicate content, but it is deliberately NOT done here: the session cookie
# is host-only, so anyone currently signed in on app.evotv.co would be bounced
# to a hostname where they are signed out. Do it once nobody is relying on
# app. sessions, or set a shared cookie domain first.

# ------------------------------------------------- evotv.africa, redirect only
#
# Default is a placeholder on purpose. `.invalid` is a reserved TLD that can
# never resolve, and the explicit http:// scheme stops Caddy asking Let's
# Encrypt for a certificate it could never validate. Set REDIRECT_HOSTS in .env
# once the evotv.africa DNS records exist, and the block becomes real.
#
# A redirect still completes a TLS handshake before it can redirect, so these
# hostnames do need their own certificates.
{$REDIRECT_HOSTS:http://redirect.invalid} {
	redir https://{$REDIRECT_TARGET:evotv.co}{uri} permanent
}
