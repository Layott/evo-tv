# Template for /srv/evotv/.env on the droplet. Copy it up, fill it in, then
# `chmod 600 /srv/evotv/.env`. Never commit the filled-in version.
#
# Docker Compose reads this file twice: as env_file for the api containers, and
# for ${VAR} substitution when it builds the caddy service's environment. That
# is why the hostnames live here rather than in the Caddyfile.
#
# Do not shell-source this file. SMTP_FROM below is unquoted and contains angle
# brackets, which Docker reads literally but bash parses as a redirect. cron.sh
# extracts the one value it needs with sed for exactly this reason.

# ---------------------------------------------------------------- hostnames
# Staging, before DNS exists. sslip.io resolves any *.1-2-3-4.sslip.io to
# 1.2.3.4, so one reserved IP gives three real hostnames with real
# certificates. Replace the dashes with the reserved IP.
ACME_EMAIL=naijagameevo@gmail.com
API_HOST=api.203-0-113-7.sslip.io
WEB_HOSTS=203-0-113-7.sslip.io
APP_HOST=app.203-0-113-7.sslip.io

# Production. Swap the four lines above for these once DNS resolves, then
# `docker compose up -d caddy`. BETTER_AUTH_URL and ALLOWED_ORIGINS below have
# to move at the same time or login breaks.
#   API_HOST=api.evotv.co
#   WEB_HOSTS=evotv.co, www.evotv.co
#   APP_HOST=app.evotv.co
#   REDIRECT_HOSTS=evotv.africa, www.evotv.africa
#   REDIRECT_TARGET=evotv.co

# --------------------------------------------------------------------- core
# Must match API_HOST, scheme included. Better Auth signs cookies against it.
BETTER_AUTH_URL=https://api.203-0-113-7.sslip.io
# Every browser origin that calls the API. evotv.africa is a redirect and never
# originates a request, so it does not belong here.
ALLOWED_ORIGINS=https://app.203-0-113-7.sslip.io,https://203-0-113-7.sslip.io

# From the Vercel archive, unchanged.
BETTER_AUTH_SECRET=
CRON_SECRET=
# Must not change, ever. The office media agent and the /admin/schedule file
# browser both authenticate with this exact value.
PLAYOUT_SECRET=

# ----------------------------------------------------------------- database
# DO Managed Postgres, private VPC host, pooler port 25061. lib/db/index.ts
# sets prepare: false, which the transaction-mode pooler requires. sslmode is
# read from this string, so keep it.
DATABASE_URL=postgresql://doadmin:PASSWORD@private-evotv-db-do-user-0-0.k.db.ondigitalocean.com:25061/defaultdb?sslmode=require

# ----------------------------------------------------------- object storage
# Setting SPACES_KEY is what activates the Spaces adapter. Unset it and
# lib/storage/index.ts falls back to Vercel Blob with no deploy.
SPACES_REGION=fra1
SPACES_BUCKET=evotv-media
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://evotv-media.fra1.cdn.digitaloceanspaces.com

# ------------------------------------------------------------------ sse bus
# Setting this is what allows two api containers. Unset it and lib/sse/bus.ts
# falls back to an in-process EventEmitter, at which point the second container
# silently drops every message the first one publishes.
REDIS_URL=redis://valkey:6379

# --------------------------------------------------------------------- smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EVO TV <noreply@evotv.co>
