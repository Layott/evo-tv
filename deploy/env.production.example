# Template for /srv/evotv/.env on the droplet. Copy it up, fill it in, then
# `chmod 600 /srv/evotv/.env`. Never commit the filled-in version.
#
# Every name here was derived by grepping process.env across app/, lib/, db/,
# scripts/ and components/, NOT from the old Vercel project. Those two lists
# disagree in ways that matter: see AUTH_SECRET below.
#
# Docker Compose reads this file twice: as env_file for the api containers, and
# for ${VAR} substitution when building the caddy service's environment. That
# is why the hostnames live here rather than in the Caddyfile.
#
# Do not shell-source this file. SMTP_FROM is unquoted and contains angle
# brackets, which Docker reads literally but bash parses as a redirect. cron.sh
# extracts the one value it needs with sed for exactly this reason.

# ---------------------------------------------------------------- hostnames
# Consumed by docker-compose.yml -> caddy. Changing these plus the two auth
# values below is the entire staging-to-production flip.
ACME_EMAIL=naijagameevo@gmail.com
API_HOST=api.evotv.co
WEB_HOSTS=evotv.co, www.evotv.co
APP_HOST=app.evotv.co
REDIRECT_HOSTS=evotv.africa, www.evotv.africa
REDIRECT_TARGET=evotv.co

# --------------------------------------------------------------------- core
# Better Auth signs cookies against this and it must match API_HOST exactly,
# scheme included. lib/auth/index.ts falls back to http://localhost:3060.
# Share the session cookie across evotv.co, www., app. and api. Without it the
# cookie is host-only and Google sign-in silently fails: the callback lands on
# BETTER_AUTH_URL (api.), sets a cookie there, then returns the user to
# evotv.co where it does not exist.
COOKIE_DOMAIN=.evotv.co

BETTER_AUTH_URL=https://api.evotv.co

# Every browser origin allowed to call the API cross-origin. app.evotv.co is a
# different origin from api.evotv.co, so without this the SPA cannot sign in.
# evotv.africa is a redirect and never originates a request, so it is absent
# deliberately.
ALLOWED_ORIGINS=https://app.evotv.co,https://evotv.co,https://www.evotv.co

# !! AUTH_SECRET, *not* BETTER_AUTH_SECRET !!
# lib/auth/index.ts:23 reads AUTH_SECRET and falls back to the literal string
# "dev_secret". Nothing in this codebase reads BETTER_AUTH_SECRET, so setting
# that name instead boots cleanly, logs nothing, and signs every session with a
# value published in a public repo. The same variable also derives signed
# storage URLs (lib/storage/local.ts) and channel stream keys
# (lib/video/stream-key.ts), so a wrong name means forgeable stream keys too.
AUTH_SECRET=

# Bearer token cron.sh sends. Six jobs 403 without it.
CRON_SECRET=

# Must not change, ever. The office media agent and the /admin/schedule file
# browser both authenticate with this exact value.
PLAYOUT_SECRET=

# Salts sha256(ip) in the login_events forensic table. Falls back to
# "evotv-fallback-salt", which is in a public repo, and IPv4 is only 4 billion
# values, so an unset salt means the stored hashes are reversible by anyone.
# Changing it later does not lose data, it just stops old rows correlating with
# new ones.
LOGIN_HASH_SALT=

# ------------------------------------------------------------ where they are
# Sign-in and every app request go to api.evotv.co, which is NOT proxied by
# Cloudflare: those requests reach the droplet directly and carry no cf-*
# headers, so the location on a login row cannot come from Cloudflare alone.
# lib/geo/ip-location.ts covers that with two sources, cheapest first.
#
# 1. A local city database. No network, no cost, no third party sees anything.
#    Put the file at /srv/evotv/geoip/city.mmdb, which docker-compose mounts
#    read-only into both api containers:
#
#      /srv/evotv/geoip-refresh.sh
#
#    That pulls DB-IP City Lite, which needs no account. Set MAXMIND_LICENSE_KEY
#    instead to pull GeoLite2, which needs a free MaxMind account and is
#    generally sharper on mobile networks. Both refresh monthly at source, so
#    the download belongs on a cron; the file still works when stale.
GEOIP_DB_PATH=/srv/evotv/geoip/city.mmdb
MAXMIND_LICENSE_KEY=

# 2. IPinfo, called only for the addresses the local file places in a country
#    but not a city, and cached for a day per address. The free tier is 50k
#    lookups a month against a few sign-ins a day, so the ceiling is not the
#    constraint. Leave it empty and the local file is the whole answer.
#    Token: ipinfo.io > Dashboard > Token.
IPINFO_TOKEN=

# How many IPinfo lookups a day, counted in Valkey so both api containers share
# one ceiling. A month is the wrong unit to discover you have exhausted, since
# it fails on the 20th and stays failed; a day turns that into a bad afternoon.
# Only sign-ins ever reach IPinfo, so this is a backstop rather than a limit
# anything normally approaches. Default 1000.
IPINFO_DAILY_MAX=

# ----------------------------------------------------------------- database
# Runtime, through PgBouncer on port 25061. lib/db/index.ts sets
# prepare: false, which transaction-mode pooling requires. sslmode is read from
# this string, so keep it.
#
# Two things people get wrong here:
#
#   - The database segment is the POOL NAME (evotv-pool), not defaultdb. DO's
#     pooler routes by it. Using defaultdb on 25061 fails to connect.
#   - The host must start with `private-`. The public host works but leaves the
#     VPC, which costs bandwidth and adds latency for no benefit.
#
# The Basic tier allows only 22 backend connections in total, which is why the
# pooler is not optional: two api containers at max:10 each would eat 20 of
# them before the first migration ran.
DATABASE_URL=postgresql://doadmin:PASSWORD@private-evotv-db-do-user-0-0.g.db.ondigitalocean.com:25061/evotv-pool?sslmode=require

# Migrations and seeds only, direct on port 25060, database defaultdb. Both
# differ from the pooled URI above. db/migrate.ts prefers this because DDL and
# named prepared statements do not survive a transaction pooler handing the
# connection to another client mid-session.
DATABASE_URL_UNPOOLED=postgresql://doadmin:PASSWORD@private-evotv-db-do-user-0-0.g.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ----------------------------------------------------------- object storage
# Setting SPACES_KEY is what activates the Spaces adapter. Unset it and
# lib/storage/index.ts falls back to Vercel Blob with no deploy. That is the
# rollback, not a redeploy.
SPACES_REGION=fra1
SPACES_BUCKET=evotv-media
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://evotv-media.fra1.cdn.digitaloceanspaces.com

# ------------------------------------------------------------------ sse bus
# Setting this is what allows two api containers. Unset it and lib/sse/bus.ts
# falls back to an in-process EventEmitter, at which point the second container
# silently drops every message the first publishes. No error, just missing
# chat messages.
REDIS_URL=redis://valkey:6379

# --------------------------------------------------------------------- mail
# Resend's HTTPS API, and nothing else, because nothing else can work here.
#
# `lib/email/send.ts` tries Resend first and SMTP second. On 2026-08-17 the SMTP
# leg was tested from the droplet and **every outbound SMTP port is blocked**:
# 25, 465 and 587 all time out, to Resend and to Gmail alike, while HTTPS to
# api.resend.com connects fine. That is DigitalOcean's standard anti-spam block
# on a new account, and it applies to any provider, so a configured SMTP host
# would only add a thirty second timeout to a send that then fails anyway.
#
# SMTP_HOST is therefore deliberately empty and the rest of the SMTP values are
# left correct, so enabling the fallback is one edit on the day the block is
# lifted (a DigitalOcean support request) rather than a re-derivation.
#
# For a fallback that works *today*, use a second provider with an HTTPS API
# (Postmark, SES, SendGrid). A second SMTP provider changes nothing.
#
# SMTP_FROM must be on a domain verified in Resend, or delivery is spam-foldered
# at best. evotv.co is verified.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=EVO TV <noreply@evotv.co>
RESEND_API_KEY=
EMAIL_FROM=EVO TV <noreply@evotv.co>
CONTACT_TO=

# Used to build links inside waitlist confirmation emails. Falls back to
# https://evotv.vercel.app, which is about to stop existing, so every
# confirmation link would 404.
WAITLIST_SITE_URL=https://evotv.co

# --------------------------------------------------------------------- oauth
# lib/auth/index.ts activates each provider only when both halves are present,
# so leaving a pair empty disables that provider rather than breaking boot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ------------------------------------------------------------ web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ------------------------------------------------------------------ payments
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=

# ----------------------------------------------------------------- streaming
# Which ingest new streams get. `rtmp` is the self-hosted nginx-rtmp under the
# compose `rtmp` profile; `cloudflare` needs the Stream credentials; `manual`
# means an operator pastes a manifest URL. Stated explicitly so adding a
# Cloudflare token for something else cannot silently move new streams onto it.
LIVE_INGEST=rtmp

# What an operator pastes into OBS as Server.
#
# Deliberately the droplet IP and NOT a hostname under evotv.co.
#
# RTMP cannot go through Cloudflare's proxy - the proxy handles HTTP and HTTPS
# ports only, so an ingest record would have to be DNS-only. A single DNS-only
# record under a proxied zone hands out the origin IP to anyone who enumerates
# subdomains, which defeats the orange cloud on every other hostname. No record
# means nothing to enumerate. An operator is already pasting a 32 character key,
# so pasting an IP alongside it costs nothing.
#
# Port 1935 is exposed directly whatever happens: Cloudflare cannot proxy it
# without Spectrum. Restrict the source in the DO firewall to the broadcast
# location if it is fixed, and see deploy/cloudflare-firewall.sh for locking
# 80/443 to Cloudflare's ranges.
RTMP_INGEST_URL=rtmp://138.68.126.199:1935/live

# Where nginx's HLS output is reachable from a browser. Caddy proxies /hls/* on
# the API host, so this one IS a normal proxied hostname over TLS.
RTMP_HLS_BASE_URL=https://api.evotv.co/hls

HLS_OUTPUT_DIR=/srv/hls

# ------------------------------------------------------------------- playout
# The office media agent and /admin/schedule. FFPLAYOUT_URL defaults to
# 127.0.0.1:8787, which inside a container is the container itself, not the
# office box.
FFPLAYOUT_URL=
FFPLAYOUT_CHANNEL_ID=1
FILLER_SOURCE=
FILLER_DURATION_SEC=
MEDIA_DIR=/srv/media
MEDIA_MAP=
DAY_START=06:00
PROBE_DURATION=

# --------------------------------------------------------------------- misc
# UPLOADS_DIR only matters when the local storage adapter is active, which it
# is not once SPACES_KEY is set. Both this and MEDIA_DIR point inside the
# container, so anything written there is lost on redeploy unless a volume is
# mounted for it.
UPLOADS_DIR=/srv/uploads
LOG_LEVEL=info
PILLAR=all

# ------------------------------------------------------------ app downloads
# Inlined into the browser bundle at build time (see the build args in
# docker-compose.yml), so changing one needs a rebuild, not just a restart.
# Empty means the download page says "not out yet" for that platform, which is
# the honest answer until a build exists.
#
# The APK is hosted in Spaces rather than on the droplet, so a download does not
# spend the channel's bandwidth allowance.
NEXT_PUBLIC_ANDROID_APK_URL=https://evotv-media.fra1.cdn.digitaloceanspaces.com/downloads/evotv-2026-08-16.apk
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# --------------------------------------------------- deliberately not here
# BLOB_READ_WRITE_TOKEN  gone. The Vercel Blob adapter was deleted on
#                        2026-08-16 once the last two rows holding Blob URLs
#                        were copied into Spaces. Setting it now does nothing
# POSTGRES_URL           Vercel Marketplace injection, checked before
#                        DATABASE_URL, so setting it would silently win
# BETTER_AUTH_SECRET     read by nothing, see AUTH_SECRET above
